terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
  }
}

provider "aws" {
  region = var.region
  # Credentials are taken from the environment / AWS CLI profile.
  # Nothing sensitive is ever written in these files.
}
